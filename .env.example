# Copia este archivo a .env y ajusta los valores
# Para SQLite (demo, por defecto) deja DATABASE_URL vacío o coméntalo.
# DATABASE_URL=postgresql://turitec:turitec123@localhost:5432/turitec
SECRET_KEY=turitec-dev-secret-cambiar-en-produccion
FLASK_ENV=development
HOTEL_NOMBRE=Posada Turitec

# --- Chatbot de Telegram (opcional) ---
# 1. En Telegram busca @BotFather, escribe /newbot y sigue los pasos.
#    Te dará un token como: 123456789:AAEhBOweik6ad9r_QXMENQjcrGbqCrK7g5s
# 2. Abre tu bot, escribe /start y averigua tu id de chat con:
#      python services/telegram_bot/bot.py --get-id
#    (o escribe a @userinfobot en Telegram y te dirá tu id)
# 3. Pega aquí el token y el id. Sin estos dos valores, Telegram queda
#    desactivado y la app funciona igual, solo sin avisos.
#    El token es como una contraseña: va SOLO en este archivo .env, en tu
#    computadora. Nunca lo pegues en un chat ni lo subas a internet.
#    Si se filtra, revócalo en @BotFather con /revoke y usa el token nuevo.
# TELEGRAM_BOT_TOKEN=123456789:AAEhBOweik6ad9r_QXMENQjcrGbqCrK7g5s
# TELEGRAM_CHAT_ID=123456789  # tu chat (personal): recibe los avisos y es
#    el único que puede usar /reservas y /ocupacion. Los clientes pueden
#    usar el bot con /habitaciones, /precios y /disponibilidad sin ser este chat.
# TELEGRAM_ENABLED=true
